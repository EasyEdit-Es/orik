# Copia este archivo a .env y ajusta los valores.
# El archivo .env NO debe subirse al repositorio.

# ── Ollama ─────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434

# Modelos: ajusta según los que tengas en `ollama list`
OLLAMA_MODEL=gemma3n:e2b
OLLAMA_MODEL_SMART=gpt-oss:20b
OLLAMA_MODEL_FAST=gemma3n:e2b

# Comando para arrancar Ollama si no está corriendo
OLLAMA_START_COMMAND=ollama serve
OLLAMA_START_TIMEOUT=30
OLLAMA_REQUEST_TIMEOUT=300
OLLAMA_TEMPERATURE=0.75
OLLAMA_MAX_TOKENS=4096

# ── Servidor Flask ────────────────────────────────────────
# Por defecto solo escuchamos en localhost. Cambia a 0.0.0.0 para exponerlo a la red local.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# Se genera automáticamente en .secret_key si no la defines aquí.
# FLASK_SECRET_KEY=cambia-esto-por-una-clave-larga

# Duración de la sesión de chat
SESSION_LIFETIME_DAYS=7

# ── Búsqueda web ──────────────────────────────────────────
SEARCH_MAX_RESULTS=8
SEARCH_TIMEOUT=12
SEARCH_CACHE_SIZE=64
SEARCH_CACHE_TTL=600

# ── Historial ─────────────────────────────────────────────
HISTORY_MAX_TURNS=30

# ── Autenticación opcional ────────────────────────────────
# Si defines un token, cada petición a /chat debe incluir:
#   Authorization: Bearer <token>
# ORIK_API_TOKEN=un-token-secreto-de-al-menos-32-caracteres
